/* ==========================================================================
   STELLAR NEXUS 星图终端 —— 科幻风格样式表
   --------------------------------------------------------------------------
   配色规范（与 ui/widgets.py 中的常量保持一致）：
     深空背景   #03080f / #061019
     霓虹青     #00e5ff（主色）
     霓虹紫     #a06eff（次色）
     霓虹橙     #ff963c（警示 / 强调）
     荧光绿     #50ffb4（成功 / 生态）
     警示红     #ff5a6e（危险 / 夜间模式）
     正文文字   #e6f6fd（高对比度，保证在深色面板上清晰可读）
     次要文字   #a9c9da（提高亮度后的辅助文字）
     标签文字   #8fd4ea（信息面板的字段名，偏青色便于与数值区分）
   可读性说明：所有正文/标签都保证与面板背景的亮度差 ≥ 4.5:1（WCAG AA），
     字号统一从 9pt 起步，避免小字号 + 低对比造成的"看不清"。
   说明：本样式表不使用 url() 引用任何图片，因此在 PyInstaller 单文件模式下
        不会出现资源路径失效的问题，所有光效都由 QSS 渐变与自绘控件实现。
   ========================================================================== */

/* ---------------------------------------------------------------- 全局 ---- */
* {
    outline: none;
}

QWidget {
    color: #e6f6fd;
    font-family: "Microsoft YaHei UI", "微软雅黑", "PingFang SC", "Noto Sans CJK SC", sans-serif;
    font-size: 10pt;
    selection-background-color: #0a5f78;
    selection-color: #ffffff;
}

/* 兜底：没有被具体规则命中的容器也必须是深色底，避免出现"浅底浅字看不见"。
   程序启动时还会整体设置深色 QPalette，这里是双保险。 */
QScrollArea {
    background: transparent;
    border: none;
}

QAbstractScrollArea::viewport {
    background: #061019;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QStackedWidget, QStackedWidget > QWidget {
    background: transparent;
}

QSplitter, QSplitter > QWidget {
    background: transparent;
}

QSplitter::handle:horizontal {
    background: rgba(8, 22, 34, 245);
    width: 4px;
}

QSplitter::handle:vertical {
    background: rgba(8, 22, 34, 245);
    height: 4px;
}

/* 右侧信息面板的折叠容器与标题栏 */
#InfoContainer {
    background: transparent;
}

#InfoContainer > QWidget#PanelHead {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(9, 24, 38, 248), stop:1 rgba(5, 14, 24, 248));
    border: 1px solid rgba(0, 190, 230, 165);
    border-radius: 4px;
}

QMainWindow, QDialog {
    background: #03080f;
}

QMainWindow::separator {
    background: rgba(0, 200, 240, 110);
    width: 1px;
    height: 1px;
}

/* ------------------------------------------------------------- 菜单栏 ---- */
QMenuBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #0a1a28, stop:1 #061220);
    color: #e6f6fd;
    border-bottom: 1px solid rgba(0, 200, 240, 150);
    padding: 2px 4px;
    font-size: 10pt;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 12px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background: rgba(0, 200, 240, 90);
    color: #ffffff;
    border: 1px solid rgba(0, 229, 255, 200);
}

QMenuBar::item:pressed {
    background: rgba(0, 229, 255, 130);
}

QMenu {
    background: rgba(7, 20, 32, 252);
    border: 1px solid rgba(0, 200, 240, 180);
    border-radius: 4px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 26px 6px 20px;
    border-radius: 3px;
    color: #e6f6fd;
    font-size: 10pt;
}

QMenu::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(0, 229, 255, 120), stop:1 rgba(160, 110, 255, 100));
    color: #ffffff;
    border: 1px solid rgba(0, 229, 255, 180);
}

QMenu::item:disabled {
    color: #7b93a3;
}

QMenu::separator {
    height: 1px;
    background: rgba(0, 190, 230, 120);
    margin: 4px 8px;
}

/* -------------------------------------------------------------- 工具栏 ---- */
QToolBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #0a1c2c, stop:1 #071422);
    border-bottom: 1px solid rgba(0, 200, 240, 160);
    spacing: 4px;
    padding: 4px 6px;
}

QToolBar::separator {
    background: rgba(0, 190, 230, 130);
    width: 1px;
    margin: 4px 6px;
}

QToolButton {
    background: rgba(12, 30, 44, 230);
    border: 1px solid rgba(0, 180, 220, 170);
    border-radius: 3px;
    padding: 4px 10px;
    color: #e6f6fd;
    font-size: 10pt;
}

QToolButton:hover {
    background: rgba(0, 140, 180, 190);
    border: 1px solid rgba(0, 229, 255, 240);
    color: #ffffff;
}

QToolButton:checked {
    background: rgba(0, 200, 240, 200);
    border: 1px solid #7ff0ff;
    color: #021018;
    font-weight: bold;
}

/* -------------------------------------------------------------- 状态栏 ---- */
QStatusBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #071422, stop:1 #0a1c2c);
    border-top: 1px solid rgba(0, 200, 240, 150);
    color: #cfe9f6;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #d6eefb;
    padding: 1px 6px;
    font-size: 9pt;
}

/* -------------------------------------------------------------- 面板框 ---- */
#LeftPanel, #InfoPanel, #InfoContainer {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(9, 24, 38, 248), stop:1 rgba(5, 14, 24, 248));
    border: 1px solid rgba(0, 190, 230, 165);
    border-radius: 4px;
}

QSplitter::handle {
    background: rgba(0, 170, 210, 110);
    width: 3px;
}

QSplitter::handle:hover {
    background: rgba(0, 229, 255, 210);
}

/* ---------------------------------------------------------------- 标签 ---- */
QLabel {
    background: transparent;
    color: #e6f6fd;
}

QLabel#PanelTitle {
    color: #9ff6ff;
    font-size: 11pt;
    font-weight: bold;
    letter-spacing: 2px;
}

QLabel#Hint {
    color: #a9c9da;
    font-size: 9pt;
}

/* ---------------------------------------------------------------- 按钮 ---- */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(0, 190, 230, 120), stop:1 rgba(6, 16, 26, 220));
    border: 1px solid rgba(0, 200, 240, 170);
    border-radius: 3px;
    color: #ffffff;
    padding: 6px 14px;
    min-height: 20px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(0, 229, 255, 180), stop:1 rgba(10, 30, 44, 230));
    border: 1px solid #00e5ff;
}

QPushButton:pressed {
    background: rgba(0, 229, 255, 210);
    color: #02121a;
}

QPushButton:disabled {
    background: rgba(20, 32, 42, 180);
    border: 1px solid rgba(100, 130, 150, 160);
    color: #8ba4b3;
}

/* ------------------------------------------------------ 输入框 / 下拉框 ---- */
QLineEdit, QDoubleSpinBox, QSpinBox, QDateTimeEdit, QComboBox {
    background: rgba(8, 22, 34, 240);
    border: 1px solid rgba(0, 190, 230, 190);
    border-radius: 3px;
    padding: 4px 6px;
    color: #eafaff;
    min-height: 18px;
}

QLineEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus,
QDateTimeEdit:focus, QComboBox:focus {
    border: 1px solid #00e5ff;
    background: rgba(8, 26, 38, 235);
}

QLineEdit:disabled, QComboBox:disabled {
    color: #8ba4b3;
    border-color: rgba(70, 100, 120, 120);
}

QComboBox::drop-down {
    border: none;
    width: 18px;
    background: rgba(0, 140, 180, 110);
}

QComboBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #9fe8ff;
}

QComboBox QAbstractItemView {
    background: rgba(8, 22, 34, 252);
    border: 1px solid rgba(0, 200, 240, 200);
    color: #eafaff;
    selection-background-color: rgba(0, 190, 230, 130);
    selection-color: #02121a;
    outline: none;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button,
QDateTimeEdit::up-button, QDateTimeEdit::down-button {
    background: rgba(0, 140, 180, 110);
    border: none;
    width: 14px;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow, QDateTimeEdit::up-arrow {
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #9fe8ff;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow, QDateTimeEdit::down-arrow {
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #9fe8ff;
}

/* 日历弹窗 */
QCalendarWidget QWidget {
    background: #08141f;
    color: #eafaff;
}

QCalendarWidget QAbstractItemView {
    background: #08141f;
    color: #e2f4fb;
    selection-background-color: rgba(0, 190, 230, 150);
    selection-color: #02121a;
}

/* ---------------------------------------------------------------- 滑杆 ---- */
QSlider::groove:horizontal {
    height: 4px;
    background: rgba(20, 45, 60, 220);
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(0, 190, 230, 150), stop:1 #00e5ff);
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #eafcff;
    border: 1px solid #00e5ff;
    width: 10px;
    margin: -5px 0;
    border-radius: 5px;
}

QSlider::handle:horizontal:hover {
    background: #ffffff;
    border: 2px solid #00e5ff;
}

/* ---------------------------------------------------------- 复选框 ---- */
QCheckBox {
    color: #e2f4fb;
    spacing: 6px;
    padding: 1px 0;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid rgba(0, 180, 220, 160);
    border-radius: 2px;
    background: rgba(6, 18, 28, 200);
}

QCheckBox::indicator:hover {
    border: 1px solid #00e5ff;
}

QCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #00e5ff, stop:1 #50ffb4);
    border: 1px solid #7ff0ff;
}

QCheckBox:disabled {
    color: #8ba4b3;
}

/* ---------------------------------------------------------------- 分组 ---- */
QGroupBox {
    border: 1px solid rgba(0, 170, 210, 110);
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 6px;
    color: #c8f2ff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: #7ff0ff;
}

/* -------------------------------------------------------------- 标签页 ---- */
QTabWidget::pane {
    border: 1px solid rgba(0, 150, 190, 100);
    border-radius: 3px;
    background: rgba(5, 14, 22, 130);
    top: -1px;
}

QTabBar::tab {
    background: rgba(8, 20, 30, 210);
    color: #b6d8e8;
    border: 1px solid rgba(0, 170, 210, 120);
    border-bottom: none;
    padding: 4px 8px;
    margin-right: 1px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}

QTabBar::tab:hover {
    color: #ffffff;
    background: rgba(0, 140, 180, 170);
}

QTabBar::tab:selected {
    background: rgba(0, 160, 200, 200);
    color: #ffffff;
    border: 1px solid rgba(0, 229, 255, 190);
    border-bottom: none;
}

/* ------------------------------------------------------------ 滚动区域 ---- */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    background: rgba(6, 16, 26, 150);
    width: 8px;
    margin: 0;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(0, 180, 220, 150), stop:1 rgba(0, 229, 255, 190));
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #00e5ff;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: rgba(6, 16, 26, 150);
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: rgba(0, 190, 230, 170);
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ------------------------------------------------------------ 文本浏览 ---- */
QTextBrowser, QTextEdit, QPlainTextEdit {
    background: rgba(6, 18, 28, 235);
    border: 1px solid rgba(0, 180, 220, 140);
    border-radius: 3px;
    color: #e6f6fd;
    selection-background-color: #0a5f78;
}

/* ------------------------------------------------------------ 提示气泡 ---- */
QToolTip {
    background: rgba(8, 24, 36, 252);
    color: #f0fbff;
    border: 1px solid rgba(0, 229, 255, 180);
    border-radius: 3px;
    padding: 4px 8px;
}

/* ------------------------------------------------------------ 对话框 ---- */
QMessageBox {
    background: #061019;
}

QMessageBox QLabel {
    color: #e6f6fd;
}

QMessageBox QPushButton {
    min-width: 72px;
}

QFileDialog {
    background: #061019;
}

/* ------------------------------------------------------------ 进度条 ---- */
QProgressBar {
    background: rgba(20, 45, 60, 200);
    border: 1px solid rgba(0, 170, 210, 130);
    border-radius: 3px;
    text-align: center;
    color: #ffffff;
    height: 14px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #00b4d8, stop:1 #00e5ff);
    border-radius: 2px;
}
